# Copy to .env, chmod 600. Generate secrets with: openssl rand -hex 32
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_API_BASE=https://api.digikey.com
DIGIKEY_SITE=US
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=USD
DIGIKEY_DAILY_LIMIT=1000
DIGIKEY_PER_MINUTE=100
DIGIKEY_CONCURRENCY=4

MOUSER_SEARCH_API_KEY=
MOUSER_API_BASE=https://api.mouser.com
MOUSER_DAILY_LIMIT=1000
MOUSER_PER_MINUTE=25
MOUSER_BATCH_SIZE=10

QUOTA_RESERVE=50
CACHE_TTL_HOURS=12
NOTFOUND_TTL_HOURS=24
SEARCH_TTL_HOURS=6
MAX_WAIT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=20
BOM_MAX_LINES=300
DATA_DIR=/data
LOG_LEVEL=INFO

# One key per console: name:key pairs
CONSOLE_API_KEYS=planner:<hex>,prc:<hex>,mcp:<hex>

# MCP container only (compose passes just these three to it)
MCP_CONSOLE_KEY=<same hex as mcp: above>
MCP_BEARER_TOKEN=<hex>
# PRICING_API_URL=http://api:8080   (set by compose)
# MCP_PORT=8090
